{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "nikfedorov/openhabit",
    "type": "project",
    "description": "Habit tracker with AI integration.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.5.0",
        "dedoc/scramble": "^0.13.21",
        "filament/filament": "^5.6.1",
        "laravel/framework": "^13.6.0",
        "laravel/horizon": "^5.46.0",
        "laravel/octane": "^2.17.2",
        "laravel/pulse": "^1.7",
        "laravel/sail": "^1.57",
        "laravel/sanctum": "^4.3.1",
        "livewire/livewire": "^4.2.4",
        "nunomaduro/essentials": "^1.2.0",
        "nutgram/laravel": "^1.7.1",
        "rlanvin/php-rrule": "^2.6",
        "spatie/laravel-translatable": "^6.14.1",
        "spatie/phpunit-watcher": "^1.24.4"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.3.0",
        "fakerphp/faker": "^1.24.1",
        "larastan/larastan": "^3.9.6",
        "laravel/boost": "^2.4.5",
        "laravel/pail": "^1.2.6",
        "laravel/pint": "^1.29.1",
        "laravel/telescope": "^5.20",
        "laravel/tinker": "^3.0.2",
        "mockery/mockery": "^1.6.12",
        "nunomaduro/collision": "^8.9.4",
        "pestphp/pest": "^4.6.3",
        "pestphp/pest-plugin-laravel": "^4.1.0",
        "pestphp/pest-plugin-livewire": "^4.1.0",
        "pestphp/pest-plugin-type-coverage": "^4.0.4",
        "rector/rector": "^2.4.2",
        "roave/security-advisories": "dev-latest"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "bun install",
            "bun run build"
        ],
        "dev-full": [
            "Composer\\Config::disableProcessTimeout",
            "bunx concurrently -c \"#e26638,#fb7185,#fdba74,#3866e2\" \"php artisan horizon:listen --poll\" \"php artisan pail --timeout=0\" \"npm run dev\" \"php artisan schedule:work\" --names=horizon,logs,vite,schedule --kill-others"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "bunx concurrently -c \"#e26638,#fb7185,#3866e2\" \"php artisan horizon:listen --poll\" \"php artisan pail --timeout=0\" \"php artisan schedule:work\" --names=horizon,logs,schedule --kill-others"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan clear",
            "@update:requirements"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "update:requirements": [
            "composer bump",
            "bunx npm-check-updates -u"
        ],
        "lint": [
            "pint --parallel --format agent",
            "rector --output-format=json",
            "bun run lint"
        ],
        "test:type-coverage": "pest --type-coverage --min=100 --compact",
        "test:lint": [
            "pint --parallel --format agent",
            "rector --output-format=json",
            "bun run test:lint"
        ],
        "test:app": "XDEBUG_MODE=\"coverage\" pest --parallel --coverage --exactly=100.0",
        "test:commands": "XDEBUG_MODE=\"coverage\" pest --parallel --configuration=phpunit-suites.xml --testsuite=Commands --coverage --coverage-filter=app/Console/Commands --exactly=100.0",
        "test:actions": "XDEBUG_MODE=\"coverage\" pest --parallel --configuration=phpunit-suites.xml --testsuite=Actions --coverage --coverage-filter=app/Actions --exactly=100.0",
        "test:jobs": "XDEBUG_MODE=\"coverage\" pest --parallel --configuration=phpunit-suites.xml --testsuite=Jobs --coverage --coverage-filter=app/Jobs --exactly=100.0",
        "test:notifications": "XDEBUG_MODE=\"coverage\" pest --parallel --configuration=phpunit-suites.xml --testsuite=Notifications --coverage --coverage-filter=app/Notifications --exactly=100.0",
        "test:services": "XDEBUG_MODE=\"coverage\" pest --parallel --configuration=phpunit-suites.xml --testsuite=Services --coverage --coverage-filter=app/Services --exactly=100.0",
        "test:suites": [
            "@test:commands",
            "@test:actions",
            "@test:jobs",
            "@test:notifications",
            "@test:services"
        ],
        "test:types": "phpstan",
        "test:api-schema": [
            "php artisan scramble:export --no-interaction",
            "php -r \"file_put_contents('resources/js/api-schema.json', json_encode(json_decode(file_get_contents('resources/js/api-schema.json')), JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE) . PHP_EOL);\""
        ],
        "test:vue": "bun run test:vue",
        "test": [
            "@test:type-coverage",
            "@test:lint",
            "@test:app",
            "@test:types",
            "@test:api-schema",
            "@test:vue"
        ],
        "watch": "vendor/bin/phpunit-watcher watch --filter models"
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
